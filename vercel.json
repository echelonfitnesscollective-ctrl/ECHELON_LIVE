        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'self' https://plkdyvtriajpzcfgtwzp.supabase.co https://calendar.google.com https://*.notion.site; frame-ancestors 'none'; form-action 'self' https://formspree.io; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://plkdyvtriajpzcfgtwzp.supabase.co https://formspree.io; upgrade-insecure-requests" }
      ]
